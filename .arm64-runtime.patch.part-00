diff --git a/.env.example b/.env.example
index 5fb93f0..8b5793a 100644
--- a/.env.example
+++ b/.env.example
@@ -5,7 +5,7 @@ UCVR_PIN=1234
 LOG_LEVEL=info
 UCVR_DEMO_INTERVAL_MS=5000
 
-UCVR_UPDATE_REPOSITORY=jstnjx/uc-virtual-remote
+UCVR_UPDATE_REPOSITORY=jstnjx/uc-virtual-remote-arm64
 UCVR_UPDATE_BRANCH=main
 UCVR_GITHUB_TOKEN=
 
@@ -14,6 +14,12 @@ UCVR_INTEGRATION_REGISTRY_URLS=
 UCVR_INTEGRATION_REGISTRY_URL=https://raw.githubusercontent.com/JackJPowell/uc-intg-list/refs/heads/main/registry.json
 UCVR_INTEGRATION_PORT_START=11091
 
+# ARM64 appliance runtime. External integrations use the Docker daemon running
+# inside the top-level container; normal UC tarballs run as native processes.
+UCVR_DIND=true
+UCVR_DIND_STORAGE_DRIVER=overlay2
+UCVR_NATIVE_INTEGRATION_HOST=127.0.0.1
+
 # Optional host-side path mounted into the container at /data.
-# The one-command installer uses /var/lib/uc-virtual-remote.
-# UCVR_HOST_DATA_DIR=/absolute/host/path/to/uc-virtual-remote/data
+# The one-command installer uses /var/lib/uc-virtual-remote-arm64.
+# UCVR_HOST_DATA_DIR=/absolute/host/path/to/uc-virtual-remote-arm64/data
diff --git a/.github/workflows/build.yml b/.github/workflows/build.yml
index ef953ac..1aafdcc 100644
--- a/.github/workflows/build.yml
+++ b/.github/workflows/build.yml
@@ -51,6 +51,11 @@ jobs:
       - name: Check out repository
         uses: actions/checkout@v6
 
+      - name: Set up QEMU
+        uses: docker/setup-qemu-action@v4
+        with:
+          platforms: arm64
+
       - name: Set up Docker Buildx
         uses: docker/setup-buildx-action@v4
 
@@ -59,8 +64,8 @@ jobs:
         with:
           context: .
           file: ./Dockerfile
-          platforms: linux/amd64
+          platforms: linux/arm64
           push: false
-          tags: uc-virtual-remote:ci
+          tags: uc-virtual-remote-arm64:ci
           cache-from: type=gha,scope=build
           cache-to: type=gha,mode=max,scope=build
diff --git a/.github/workflows/docker.yml b/.github/workflows/docker.yml
index 93f8f5c..44a9a19 100644
--- a/.github/workflows/docker.yml
+++ b/.github/workflows/docker.yml
@@ -65,8 +65,8 @@ jobs:
             type=raw,value=${{ github.event.client_payload.major }},enable=${{ github.event_name == 'repository_dispatch' }}
             type=raw,value=latest,enable=${{ github.event_name == 'repository_dispatch' && github.event.client_payload.stable == 'true' }}
           labels: |
-            org.opencontainers.image.title=UC Virtual Remote
-            org.opencontainers.image.description=Self-hosted virtual Unfolded Circle Remote Core
+            org.opencontainers.image.title=UC Virtual Remote ARM64
+            org.opencontainers.image.description=ARM64 virtual Unfolded Circle Remote appliance with native custom integrations and internal Docker
             org.opencontainers.image.version=${{ github.event_name == 'repository_dispatch' && github.event.client_payload.version || github.ref_name }}
             org.opencontainers.image.licenses=MIT
 
@@ -76,7 +76,7 @@ jobs:
         with:
           context: .
           file: ./Dockerfile
-          platforms: linux/amd64,linux/arm64
+          platforms: linux/arm64
           push: true
           tags: ${{ steps.meta.outputs.tags }}
           labels: ${{ steps.meta.outputs.labels }}
diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
index 6a6602b..7bec97b 100644
--- a/.github/workflows/release.yml
+++ b/.github/workflows/release.yml
@@ -66,7 +66,7 @@ jobs:
 
           echo "version=$PACKAGE_VERSION" >> "$GITHUB_OUTPUT"
           echo "tag=$RELEASE_TAG" >> "$GITHUB_OUTPUT"
-          echo "archive_root=uc-virtual-remote-$PACKAGE_VERSION" >> "$GITHUB_OUTPUT"
