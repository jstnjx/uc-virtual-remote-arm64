TZ=Europe/Berlin
UCVR_REST_PORT=11090
UCVR_NAME=Virtual Remote 3
UCVR_PIN=1234
LOG_LEVEL=info
UCVR_DEMO_INTERVAL_MS=5000

UCVR_UPDATE_REPOSITORY=jstnjx/uc-virtual-remote-arm64
UCVR_UPDATE_BRANCH=main
UCVR_GITHUB_TOKEN=

# Multiple registry URLs may be separated with commas.
UCVR_INTEGRATION_REGISTRY_URLS=
UCVR_INTEGRATION_REGISTRY_URL=https://raw.githubusercontent.com/JackJPowell/uc-intg-list/refs/heads/main/registry.json
UCVR_INTEGRATION_PORT_START=11091

# ARM64 appliance runtime. External integrations use the Docker daemon running
# inside the top-level container; normal UC tarballs run as native processes.
UCVR_DIND=true
UCVR_DIND_STORAGE_DRIVER=overlay2
UCVR_NATIVE_INTEGRATION_HOST=127.0.0.1

# Optional host-side path mounted into the container at /data.
# The one-command installer uses /var/lib/uc-virtual-remote-arm64.
# UCVR_HOST_DATA_DIR=/absolute/host/path/to/uc-virtual-remote-arm64/data
