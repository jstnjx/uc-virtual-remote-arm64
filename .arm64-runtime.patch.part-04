-UCVR_UPDATE_REPOSITORY=${UCVR_UPDATE_REPOSITORY:-jstnjx/uc-virtual-remote}
+UCVR_UPDATE_REPOSITORY=${UCVR_UPDATE_REPOSITORY:-jstnjx/uc-virtual-remote-arm64}
