{
  "name": "web-configurator",
  "version": "2.3.3-unfoldedtools.8",
  "license": "GPL-3.0-only",
  "description": "Web based application to configure Unfolded Circle's Remote Two/3",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:sim": "VITE_API_PROXY=http://localhost:8080/ VITE_API_HOST=/ vite",
    "sim:up": "tools/simulator/sim.sh up",
    "sim:down": "tools/simulator/sim.sh down",
    "sim:reset": "tools/simulator/sim.sh reset",
    "build": "run-p type-check build-only",
    "build:dev": "run-p type-check build-only:dev",
    "preview": "vite preview --port 4173",
    "test:unit": "vitest run --environment jsdom --exclude 'test/e2e/**'",
    "test:unit:watch": "vitest --environment jsdom --exclude 'test/e2e/**'",
    "test:e2e": "playwright test",
    "test:e2e:visual": "docker/visual/visual.sh",
    "test:e2e:visual:update": "docker/visual/visual.sh --update-snapshots",
    "build-only": "vite build",
    "build-only:dev": "vite build --mode dev",
    "type-check": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false && vue-tsc --noEmit -p tsconfig.config.json --composite false",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:unfolded-tools": "npm run build"
  },
  "dependencies": {
    "@vuepic/vue-datepicker": "^14.0.0",
    "@vueuse/core": "^14.3.0",
    "axios": "^1.18.1",
    "cropperjs": "^1.6.2",
    "date-fns": "^4.4.0",
    "grid-layout-plus": "^1.1.1",
    "i18next-vue": "^5.0.0",
    "pinia": "^4.0.2",
    "vue": "^3.5.40",
    "vue-markdown-render": "^2.3.1",
    "vue-picture-cropper": "^1.0.0",
    "vue-router": "^5.2.0",
    "vue3-carousel": "^0.17.0",
    "vuedraggable": "^4.1.0"
  },
  "overrides": {
    "markdown-it": "^14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.61.1",
    "@tsconfig/node22": "^22.0.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.12.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.3",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.7.0",
    "eslint-plugin-vue": "^10.10.0",
    "git-describe": "^4.1.1",
    "globals": "^17.7.0",
    "jsdom": "^26.1.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.5",
    "sass": "^1.69.7",
    "semver": "^7.5.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8"
  }
}
