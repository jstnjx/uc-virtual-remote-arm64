{
  "extends": ["@vue/tsconfig/tsconfig.dom.json"],
  "include": [
    "env.d.ts",
    "src/**/*",
    "src/**/*.vue",
    "public/icons/selection.json"
  ],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["./public/*"],
      "@/*": ["./src/*"]
    },
    "target": "es2019",
    "lib": ["es2021", "dom"]
  }
}
