{
  "name": "uc-virtual-remote",
  "version": "0.12.7",
  "description": "Self-hosted virtual Unfolded Circle Remote Core with a bundled GPL Web Configurator community build, health monitoring, media services, and virtual Dock support.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node launcher.js",
    "dev": "node --watch src/index.js",
    "test": "node --experimental-sqlite --test test/*.test.js",
    "check": "node tools/check-source.js",
    "ci": "npm run check && npm test",
    "prepare:web-configurator": "node tools/prepare-web-configurator.js",
    "prestart": "npm run prepare:web-configurator",
    "predev": "npm run prepare:web-configurator"
  },
  "license": "MIT"
}
